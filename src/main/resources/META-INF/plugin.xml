<idea-plugin>
    <id>com.newbieking.springtestgen</id>
    <name>Spring Test Generator</name>
    <vendor url="https://github.com/yinzhenyu1994/spring-test-generator-plugin">newbieking</vendor>

    <description><![CDATA[
        Generate comprehensive Spring Boot test cases with a single click.
        Supports Controller (MockMvc/RestAssured/WebTestClient), Service, Component,
        Repository, Mapper, and Utility classes with intelligent test scenario generation.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 统一的类级别 Gutter Icon：对所有 bean 类型一视同仁 -->
        <codeInsight.lineMarkerProvider
            language="JAVA"
            implementationClass="com.newbieking.springtestgen.actions.ClassLevelLineMarkerProvider"/>

        <codeInsight.lineMarkerProvider
            language="JAVA"
            implementationClass="com.newbieking.springtestgen.actions.GenerateTestForMethodAction$LineMarkerProvider"/>

        <!-- Kotlin 支持 -->
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.newbieking.springtestgen.actions.ClassLevelLineMarkerProvider"/>

        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.newbieking.springtestgen.actions.GenerateTestForMethodAction$LineMarkerProvider"/>

        <!-- 应用级别配置 -->
        <applicationConfigurable
            parentId="tools"
            instance="com.newbieking.springtestgen.ui.SettingsConfigurable"
            id="com.newbieking.springtestgen.ui.SettingsConfigurable"
            displayName="Spring Test Generator"/>

        <!-- 项目级别设置持久化 -->
        <projectService
            serviceImplementation="com.newbieking.springtestgen.services.SettingsService"/>
    </extensions>

    <actions>
        <!-- 统一的 Generate Test Action（类级别入口，用于 Project View 右键菜单） -->
        <action id="SpringTestGen.GenerateTestAction"
                class="com.newbieking.springtestgen.actions.GenerateTestAction"
                text="Generate Spring Test"
                description="Generate test class for selected Spring bean (Controller/Service/Component/Repository/Mapper/Utility)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- 方法级别 Action（Controller 端点方法，保留在方法右键菜单） -->
        <action id="SpringTestGen.GenerateTestMethodAction"
                class="com.newbieking.springtestgen.actions.GenerateTestForMethodAction"
                text="Generate Test for Endpoint Method"
                description="Generate test cases for a single Spring MVC endpoint method">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>